---
import GamePanel from '../components/GamePanel.astro';
import HallOfFame from '../components/HallOfFame.astro';
import RewardPopup from '../components/RewardPopup.astro';
import RocketButton from '../components/RocketButton.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const pageTitle = 'BuilderClan AISAT | Hall of Fame';
const pageDescription =
	'Join the BuilderClan AISAT community, where creativity meets action.';
const publicUrl = new URL(import.meta.env.BASE_URL + 'hall-of-fame/', Astro.site!);
const shareImage = new URL(
	import.meta.env.BASE_URL + 'assets/images/builderclan/about.jpeg',
	Astro.site!,
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			if ('scrollRestoration' in history) {
				history.scrollRestoration = 'manual';
			}
			if (window.location.hash.length <= 1) {
				const root = document.documentElement;
				root.dataset.freshLoad = 'true';
				const markVisitorControl = () => {
					if (root.dataset.freshLoadComplete !== 'true') {
						root.dataset.freshLoadCancelled = 'true';
					}
				};

				window.addEventListener('touchstart', markVisitorControl, {
					capture: true,
					once: true,
					passive: true,
				});
				window.addEventListener('pointerdown', markVisitorControl, {
					capture: true,
					once: true,
					passive: true,
				});
				window.addEventListener('wheel', markVisitorControl, {
					capture: true,
					once: true,
					passive: true,
				});
				window.addEventListener('keydown', markVisitorControl, {
					capture: true,
					once: true,
				});
				window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
			}
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link
			rel="icon"
			type="image/svg+xml"
			href={import.meta.env.BASE_URL + 'assets/images/builderclan/builderLogoAISAT.svg'}
		/>
		<link rel="canonical" href={publicUrl} />
		<meta name="description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="BuilderClan AISAT" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={publicUrl} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="275" />
		<meta property="og:image:height" content="183" />
		<meta
			property="og:image:alt"
			content="Students working at desktop computers in a classroom while an instructor stands at the front"
		/>
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={shareImage} />
		<meta
			name="twitter:image:alt"
			content="Students working at desktop computers in a classroom while an instructor stands at the front"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<SiteHeader />
		<main>
			<HallOfFame page />
		</main>
		<SiteFooter />
		<RocketButton />
		<RewardPopup />
		<GamePanel />
		<script src="../scripts/site.ts"></script>
	</body>
</html>
