---
import { teamTypes } from '../data/teamTypes';
---

<section
	class="team-types section-jump-target"
	id="team"
	data-reveal="fade-up"
>
	<div class="content-container">
		<header class="team-types__header">
			<h3>Meet The Team</h3>
		</header>
		<div class="team-types__grid">
			{
				teamTypes.map(({ icon, title, description }, index) => (
					<article class="team-types__card" data-reveal="slide-up" data-reveal-item={String(index + 1)}>
						<div class="team-types__icon" aria-hidden="true">
							{icon}
						</div>
						<h4>{title}</h4>
						<p>{description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.team-types {
		padding: var(--space-parent-section-block) var(--space-page-reset);
		background: var(--color-page-background);
	}

	.team-types__header {
		max-width: var(--parent-copy-max-width);
		margin: var(--space-page-reset) var(--space-centered)
			var(--space-parent-12);
		text-align: center;
	}

	.team-types__header h3 {
		margin: var(--space-page-reset);
		color: var(--color-brand-primary);
		font-size: var(--font-size-parent-section-heading);
		font-weight: var(--font-weight-parent-extrabold);
		line-height: var(--line-height-parent-tight);
		letter-spacing: var(--letter-spacing-parent-tight);
	}

	.team-types__grid {
		display: grid;
		grid-template-columns: var(--parent-team-grid-columns);
		align-items: stretch;
		gap: var(--space-parent-card-gap);
	}

	.team-types__card {
		display: flex;
		flex-direction: column;
		height: var(--section-full-width);
		padding: var(--space-parent-card-inset);
		background: var(--color-parent-card-surface);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-card);
		box-shadow: var(--shadow-parent-card);
		transition: all var(--duration-parent-standard) ease;
	}

	.team-types__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--parent-icon-box-size);
		height: var(--parent-icon-box-size);
		margin-bottom: var(--space-parent-4);
		color: var(--color-brand-primary);
		font-size: var(--parent-icon-size);
		background: var(--color-parent-card-hover);
		border-radius: var(--parent-radius-control);
	}

	.team-types__card h4 {
		margin: var(--space-page-reset) var(--space-page-reset)
			var(--space-parent-2);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-parent-card-title);
		font-weight: var(--font-weight-parent-bold);
		line-height: var(--line-height-parent-snug);
	}

	.team-types__card p {
		margin: var(--space-page-reset);
		color: var(--color-section-body-text);
		font-size: var(--font-size-parent-card-copy);
		font-weight: var(--font-weight-parent-regular);
		line-height: var(--line-height-parent-relaxed);
	}

	@media (hover: hover) and (pointer: fine) {
		.team-types__card:hover {
			border-color: var(--color-parent-brand-border-soft);
			transform: translateY(var(--parent-card-hover-offset));
		}
	}
</style>
