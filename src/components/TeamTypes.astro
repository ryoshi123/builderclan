---
import { teamTypes } from '../data/teamTypes';
---

<section
	class="team-types section-jump-target"
	id="team"
	data-reveal="slide-up"
>
	<h3>Meet The Team</h3>
	<div class="team-types__grid">
		{
			teamTypes.map(({ iconPaths, title, description }) => (
				<article class="team-types__card">
					<div class="team-types__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" focusable="false">
							{iconPaths.map((path) => <path d={path} />)}
						</svg>
					</div>
					<h4>{title}</h4>
					<p>{description}</p>
				</article>
			))
		}
	</div>
</section>

<style>
.team-types {
		position: relative;
		width: min(var(--content-max-width), var(--content-width));
		margin: var(--space-page-reset) var(--space-centered);
		padding: var(--space-team-section-top) var(--space-page-reset)
			var(--space-team-section-bottom);
		text-align: left;
	}

	.team-types > h3 {
		margin: var(--space-page-reset) var(--space-page-reset) var(--space-content-gap);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-subsection-heading);
		font-weight: var(--font-weight-section-heading);
		line-height: var(--line-height-section-heading);
		letter-spacing: var(--letter-spacing-heading);
	}

	.team-types__grid {
		display: grid;
		grid-template-columns: var(--team-grid-columns);
		gap: var(--space-content-gap);
	}

	.team-types__card {
		padding: var(--card-padding);
		color: var(--color-faded-text);
		font-size: var(--font-size-card-copy);
		font-weight: var(--font-weight-paragraph);
		line-height: var(--line-height-feature-copy);
		background: var(--card-surface);
		border: var(--card-border-width) solid var(--card-border-color);
		border-radius: var(--card-radius);
		box-shadow: var(--shadow-card-default);
		transition:
			background-color var(--duration-team-card-transform) var(--easing-site-out),
			border-color var(--duration-team-card-transform) var(--easing-site-out),
			box-shadow var(--duration-team-card-shadow) var(--easing-site-out);
	}

	.team-types__card h4 {
		margin: var(--space-page-reset) var(--space-page-reset) var(--space-card-title-gap);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-feature-copy);
		font-weight: var(--font-weight-button);
		line-height: var(--line-height-section-heading);
	}

	.team-types__card p { margin: var(--space-page-reset); }

	.team-types__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--team-icon-size);
		height: var(--team-icon-size);
		margin: var(--space-page-reset) var(--space-page-reset) var(--space-section-gutter);
		color: var(--color-brand-primary);
		background: var(--background-team-icon);
		border: var(--card-border-width) solid var(--color-standard-border);
		border-radius: var(--radius-action-standard);
	}

	.team-types__icon svg {
		width: var(--team-icon-glyph-size);
		height: var(--team-icon-glyph-size);
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: var(--team-icon-stroke-width);
	}

	@media (hover: hover) and (pointer: fine) {
		.team-types__card:hover {
			background: var(--card-surface-hover);
			border-color: var(--card-hover-border-color);
			box-shadow: var(--shadow-card-hover);
		}
	}
</style>
