---
const missionImage = `${import.meta.env.BASE_URL}assets/images/builderclan/about.jpeg`;
---

<section class="mission" data-reveal="slide-up">
	<div class="content-container">
		<article class="mission__card">
			<div class="mission__accent" aria-hidden="true"></div>
			<div class="mission__content">
				<div class="mission__text">
					<h3>Our Mission</h3>
					<p>
						Our mission is to empower students and creators by providing a platform
						to collaborate, share knowledge, and build real-world solutions. Whether
						you’re into coding, design, or innovation, BuilderClan is your space to
						make ideas come alive.
					</p>
				</div>

				<img
					src={missionImage}
					alt="Students working at desktop computers in a classroom while an instructor stands at the front"
					class="mission__image"
				/>
			</div>
		</article>
	</div>
</section>

<style>
	.mission {
		padding: var(--space-section-gutter);
		background: var(--color-page-background);
	}

	.mission > .content-container {
		max-width: var(--mission-content-max-width);
		padding-inline: var(--space-page-reset);
	}

	.mission__card {
		padding-bottom: var(--space-mission-bottom);
	}

	.mission__content {
		display: grid;
		grid-template-columns: var(--parent-mission-grid-columns);
		align-items: center;
		gap: var(--space-parent-8);
	}

	.mission__text {
		min-width: var(--mission-column-min-width);
		margin-bottom: var(--space-mission-text-bottom);
		text-align: var(--layout-mission-text-align);
	}

	.mission__text h3 {
		margin: var(--space-mission-heading-block) var(--space-page-reset);
		color: var(--color-brand-primary);
		font-size: var(--font-size-mission-heading);
		font-weight: var(--font-weight-section-heading);
		line-height: var(--line-height-feature-copy);
	}

	.mission__text p {
		margin: var(--space-mission-copy-block) var(--space-page-reset);
		color: var(--color-inverted-section-text);
		font-size: var(--font-size-section-body);
		font-weight: var(--font-weight-paragraph);
		line-height: var(--line-height-feature-copy);
	}

	.mission__image {
		width: var(--parent-mission-image-max-width);
		max-width: var(--mission-image-max-width);
		height: auto;
		margin-top: var(--space-mission-image-offset);
		justify-self: center;
		border-radius: var(--radius-mission-image);
		transition: transform var(--duration-button-standard) ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.mission__image:hover {
			box-shadow: var(--shadow-image-brand-hover);
			transform: scale(var(--scale-interactive-hover));
		}
	}
</style>
