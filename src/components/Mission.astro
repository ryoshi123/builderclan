---
const missionImage = `${import.meta.env.BASE_URL}assets/images/builderclan/about.jpeg`;
---

<section class="mission" data-reveal="slide-up">
	<div class="mission__content">
		<div class="mission__text">
			<h3>Our Mission</h3>
			<p>
				Our mission is to empower students and creators by providing a platform
				to collaborate, share knowledge, and build real-world solutions. Whether
				you’re into coding, design, or innovation, BuilderClan is your space to
				make ideas come alive.
			</p>
		</div>

		<div class="mission__image">
			<img
				src={missionImage}
				alt="Students working at desktop computers in a classroom while an instructor stands at the front"
			/>
		</div>
	</div>
</section>

<style>
.mission {
		position: relative;
		padding: var(--space-mission-top) var(--space-section-gutter) var(--space-mission-bottom);
	}

	.mission__content {
		display: flex;
		flex-direction: var(--layout-mission-direction);
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		width: min(var(--mission-content-max-width), var(--content-width));
		margin: var(--space-page-reset) var(--space-centered);
		gap: var(--space-content-gap);
	}

	.mission__text {
		flex: var(--layout-fill-share);
		min-width: var(--mission-column-min-width);
		max-width: var(--mission-copy-max-width);
		margin-bottom: var(--space-mission-text-bottom);
		color: var(--color-text-on-dark);
		text-align: var(--layout-mission-text-align);
	}

	.mission__text h3 {
		margin: var(--space-page-reset) var(--space-page-reset) var(--space-section-gutter);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-subsection-heading);
		font-weight: var(--font-weight-section-heading);
		line-height: var(--line-height-section-heading);
		letter-spacing: var(--letter-spacing-heading);
	}

	.mission__text p {
		margin: var(--space-page-reset);
		color: var(--color-section-body-text);
		font-size: var(--font-size-section-body);
		font-weight: var(--font-weight-paragraph);
		line-height: var(--line-height-feature-copy);
	}

	.mission__image {
		display: flex;
		flex: var(--layout-fill-share);
		justify-content: flex-end;
		min-width: var(--mission-column-min-width);
		max-width: var(--mission-image-max-width);
		padding: var(--space-mission-image-offset);
	}

	.mission__image img {
		width: var(--mission-image-width);
		max-width: var(--mission-image-max-width);
		height: var(--space-centered);
		border: var(--card-border-width) solid var(--color-standard-border);
		border-radius: var(--radius-mission-image);
		box-shadow: var(--shadow-card-default);
		transition: border-color var(--duration-button-standard) var(--easing-site-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.mission__image img:hover { border-color: var(--color-hover-border); }
	}
</style>
