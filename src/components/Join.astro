---
import { discordInviteUrl } from '../data/links';
---

<section class="join section-jump-target" id="join" data-reveal="fade-up">
	<div class="content-container">
		<div class="join__panel">
			<div class="join__glow" aria-hidden="true"></div>
			<div class="join__accent" aria-hidden="true"></div>
			<div class="join__text">
				<h2>Join The <span>Clan</span></h2>
				<p>Be part of our journey. Let's innovate and build together.</p>
			</div>
			<a
				href={discordInviteUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="join__button"
			>
				<span>Join Discord</span>
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M7 17 17 7M7 7h10v10" />
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.join {
		padding: var(--space-parent-16) var(--space-page-reset)
			var(--space-parent-section-block);
		background: var(--color-page-background);
	}

	.join__panel {
		position: relative;
		display: flex;
		flex-direction: var(--parent-cta-direction);
		align-items: center;
		justify-content: space-between;
		padding: var(--space-parent-cta-inset);
		overflow: hidden;
		gap: var(--space-parent-8);
		background: var(--color-parent-card-surface);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-feature);
		box-shadow: var(--shadow-parent-feature);
	}

	.join__glow {
		position: absolute;
		top: var(--game-frame-position);
		right: var(--space-parent-12);
		width: var(--parent-cta-glow-size);
		height: var(--parent-cta-glow-size);
		pointer-events: none;
		background: var(--color-parent-brand-glow-soft);
		border-radius: var(--radius-round);
		filter: blur(var(--parent-menu-blur));
		transform: translateY(var(--parent-center-x));
	}

	.join__accent {
		position: absolute;
		top: var(--space-page-reset);
		right: var(--space-page-reset);
		width: var(--game-frame-position);
		height: var(--section-full-width);
		pointer-events: none;
		background: var(--background-parent-cta-accent);
	}

	.join__text {
		position: relative;
		z-index: var(--parent-content-z);
		max-width: var(--parent-copy-max-width);
		text-align: var(--parent-cta-text-align);
	}

	.join__text h2 {
		margin: var(--space-page-reset) var(--space-page-reset)
			var(--space-parent-4);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-parent-section-heading);
		font-weight: var(--font-weight-parent-extrabold);
		line-height: var(--line-height-parent-hero);
		letter-spacing: var(--letter-spacing-parent-tight);
	}

	.join__text h2 span {
		color: var(--color-brand-primary);
	}

	.join__text p {
		margin: var(--space-page-reset);
		color: var(--color-section-body-text);
		font-size: var(--font-size-parent-section-copy);
		font-weight: var(--font-weight-parent-regular);
		line-height: var(--line-height-parent-relaxed);
	}

	.join__button {
		position: relative;
		z-index: var(--parent-content-z);
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		min-height: var(--parent-control-min-height);
		padding: var(--space-parent-4) var(--space-parent-8);
		gap: var(--space-parent-2);
		color: var(--color-parent-card-surface);
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-semibold);
		text-decoration: none;
		background: var(--color-brand-primary);
		border-radius: var(--parent-radius-pill);
		box-shadow: var(--shadow-parent-button);
		transition: all var(--duration-parent-control) var(--easing-parent-out);
	}

	.join__button svg {
		width: var(--space-parent-4);
		height: var(--space-parent-4);
		fill: none;
		stroke: currentColor;
		stroke-width: var(--parent-focus-ring-width);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (hover: hover) and (pointer: fine) {
		.join__button:hover {
			background: var(--color-parent-brand-hover);
			box-shadow: var(--shadow-parent-button-hover);
			transform: translateY(var(--parent-cta-hover-offset))
				scale(var(--parent-cta-hover-scale));
		}

		.join__button:active {
			transform: scale(var(--parent-cta-active-scale));
		}
	}
</style>
