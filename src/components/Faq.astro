---
import { faqs } from '../data/faqs';
---

<section class="faq section-jump-target" id="faq" data-reveal="slide-up">
	<div class="faq__heading">
		<h2>FAQ</h2>
	</div>

	<div class="content-container faq__grid" id="faq-list">
		{
			faqs.map((faq) => (
				<article
					class:list={[
						'faq__card',
						{ 'faq__card--hidden': !faq.visible },
					]}
					data-faq-extra={!faq.visible ? '' : undefined}
				>
					<h3>{faq.question}</h3>
					{
						'email' in faq ? (
							<p>
								{faq.answerBefore}{' '}
								<a
									class="faq__email"
									href="#join"
									data-email-link
									data-email-local={faq.email.localReversed}
									data-email-domain={faq.email.domainReversed}
								>
									Email the BuilderClan team
								</a>{' '}
								{faq.answerAfter}
							</p>
						) : (
							<p>{faq.answer}</p>
						)
					}
				</article>
			))
		}
	</div>

	<div class="faq__button-wrapper">
		<button
			type="button"
			class="faq__button"
			id="showMoreBtn"
			data-faq-toggle
			data-expanded-label="Show Less"
			aria-controls="faq-list"
			aria-expanded="false"
		>
			Show More
		</button>
	</div>
</section>

<style>
	.faq {
		position: relative;
		width: var(--section-full-width);
		margin: var(--space-page-reset);
		padding: var(--space-faq-section-top) var(--space-section-gutter)
			var(--space-faq-section-bottom);
	}

	.faq__heading {
		margin-bottom: var(--space-content-gap);
		text-align: center;
	}

	.faq__heading h2 {
		display: block;
		margin: var(--space-page-reset);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-section-heading);
		font-weight: var(--font-weight-section-heading);
		line-height: var(--line-height-heading);
		letter-spacing: var(--letter-spacing-heading);
	}

	.faq__grid {
		display: grid;
		grid-template-columns: var(--faq-grid-columns);
		margin: var(--space-page-reset) var(--space-centered);
		gap: var(--space-content-gap);
	}

	.faq__card {
		padding: var(--card-padding);
		color: var(--color-text-on-dark);
		background: var(--card-surface);
		border: var(--card-border-width) solid var(--card-border-color);
		border-radius: var(--card-radius);
		box-shadow: var(--shadow-card-default);
		transition:
			transform var(--duration-faq-card-return) var(--easing-parent-out),
			border-color var(--duration-faq-card-return) var(--easing-parent-out),
			box-shadow var(--duration-faq-card-return) var(--easing-parent-out);
	}

	.faq__card--hidden { display: none; }

	.faq__card h3 {
		margin: var(--space-page-reset) var(--space-page-reset) var(--space-card-title-gap);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-feature-copy);
		font-weight: var(--font-weight-button);
		line-height: var(--line-height-section-heading);
	}

	.faq__card p {
		margin: var(--space-page-reset);
		color: var(--color-faq-body-text);
		font-size: var(--font-size-card-copy);
		line-height: var(--line-height-faq-copy);
	}

	.faq__email { color: var(--color-brand-primary); }

	.faq__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: var(--control-min-tap-size);
		margin: var(--space-faq-button-top) var(--space-page-reset) var(--space-page-reset);
		padding: var(--space-faq-control-block) var(--space-faq-control-inline);
		color: var(--color-page-background);
		font-size: var(--font-size-action-label);
		font-weight: var(--font-weight-button);
		cursor: pointer;
		background: var(--color-faq-action-background);
		border: var(--hero-button-border-width) solid var(--color-faq-action-background);
		border-radius: var(--radius-action-standard);
		box-shadow: var(--shadow-button-default);
		transition:
			transform var(--duration-button-hover) var(--easing-parent-out),
			box-shadow var(--duration-button-hover) var(--easing-parent-out),
			background-color var(--duration-button-hover) var(--easing-parent-out),
			border-color var(--duration-button-hover) var(--easing-parent-out);
	}

	.faq__button-wrapper { text-align: center; }

	@media (hover: hover) and (pointer: fine) {
		.faq__card:hover {
			border-color: var(--card-hover-border-color);
			box-shadow: var(--shadow-card-hover);
			transform: translateY(var(--card-hover-offset));
		}
		.faq__button:hover {
			background: var(--color-faq-action-hover);
			border-color: var(--color-faq-action-hover);
			transform: translateY(var(--offset-button-hover)) scale(var(--scale-interactive-hover));
		}
	}
</style>
