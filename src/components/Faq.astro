---
import { faqs } from '../data/faqs';
---

<section class="faq section-jump-target" id="faq" data-reveal="fade-up">
	<div class="content-container faq__content">
		<header class="faq__heading">
			<h2>FAQ</h2>
		</header>

		<div class="faq__list" id="faq-list">
			{
				faqs.map((faq, index) => (
					<details
						class="faq__card"
						name="builderclan-faq"
					>
						<summary>
							<span class="faq__number">{String(index + 1).padStart(2, '0')}.</span>
							<span class="faq__question">{faq.question}</span>
							<span class="faq__indicator" aria-hidden="true">
								<span></span>
								<span></span>
							</span>
						</summary>
						<div class="faq__answer">
							{'email' in faq ? (
								<p>
									{faq.answerBefore}{' '}
									<a
										class="faq__email"
										href="#join"
										data-email-link
										data-email-local={faq.email.localReversed}
										data-email-domain={faq.email.domainReversed}
									>
										Email the BuilderClan team
									</a>{' '}
									{faq.answerAfter}
								</p>
							) : (
								<p>{faq.answer}</p>
							)}
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq {
		position: relative;
		width: var(--section-full-width);
		padding: var(--space-parent-section-block) var(--space-page-reset);
		overflow: hidden;
		background: var(--color-page-background);
		isolation: isolate;
	}

	.faq::before {
		position: absolute;
		bottom: var(--space-page-reset);
		left: var(--game-frame-position);
		z-index: var(--parent-faq-glow-layer);
		width: var(--section-full-width);
		max-width: var(--parent-faq-glow-max-width);
		height: var(--parent-faq-glow-height);
		pointer-events: none;
		content: '';
		background: var(--background-parent-faq-glow);
		filter: blur(var(--parent-faq-glow-blur));
		transform: translateX(var(--parent-center-x));
	}

	.faq__content {
		position: relative;
		z-index: var(--parent-faq-content-layer);
		max-width: var(--parent-faq-max-width);
	}

	.faq__heading {
		margin-bottom: var(--space-parent-12);
		text-align: center;
	}

	.faq__heading h2 {
		margin: var(--space-page-reset);
		color: var(--color-brand-primary);
		font-size: var(--font-size-parent-faq-heading);
		font-weight: var(--font-weight-parent-extrabold);
		line-height: var(--line-height-parent-tight);
		letter-spacing: var(--letter-spacing-parent-tight);
	}

	.faq__list {
		border-top: var(--parent-border-width) solid var(--color-parent-border);
	}

	.faq__card {
		border-bottom: var(--parent-border-width) solid var(--color-parent-border);
		interpolate-size: allow-keywords;
	}

	.faq__card summary {
		display: flex;
		align-items: flex-start;
		width: var(--section-full-width);
		padding: var(--space-parent-7) var(--space-page-reset);
		gap: var(--space-parent-6);
		cursor: pointer;
		list-style: none;
	}

	.faq__card summary::-webkit-details-marker {
		display: none;
	}

	.faq__number {
		margin-top: var(--space-parent-1);
		color: var(--color-parent-number-rest);
		font-family: var(--font-family-parent-mono);
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-bold);
		transition: color var(--duration-parent-menu) ease;
	}

	.faq__question {
		flex: 1;
		color: var(--color-section-body-text);
		font-size: var(--font-size-parent-faq-question);
		font-weight: var(--font-weight-parent-semibold);
		line-height: var(--line-height-parent-snug);
		transition: color var(--duration-parent-menu) ease;
	}

	.faq__indicator {
		position: relative;
		display: flex;
		width: var(--space-parent-7);
		height: var(--space-parent-7);
		flex: none;
		align-items: center;
		justify-content: center;
		margin-top: var(--space-parent-1);
		color: var(--color-footer-text);
		border: var(--parent-border-width) solid var(--color-parent-border-scrolled);
		border-radius: var(--radius-round);
		transition:
			color var(--duration-parent-menu) ease,
			background-color var(--duration-parent-menu) ease,
			border-color var(--duration-parent-menu) ease;
	}

	.faq__indicator span {
		position: absolute;
		width: var(--space-parent-3-5);
		height: var(--parent-border-width);
		background: currentColor;
		transition: transform var(--duration-parent-menu) ease;
	}

	.faq__indicator span:last-child {
		transform: rotate(var(--parent-quarter-turn));
	}

	.faq__card[open] .faq__number {
		color: var(--color-brand-primary);
	}

	.faq__card[open] .faq__question {
		color: var(--color-text-on-dark);
	}

	.faq__card[open] .faq__indicator {
		color: var(--color-parent-card-surface);
		background: var(--color-brand-primary);
		border-color: var(--color-brand-primary);
	}

	.faq__card[open] .faq__indicator span:last-child {
		transform: rotate(var(--space-page-reset));
	}

	.faq__answer {
		padding: var(--space-page-reset) var(--space-parent-10)
			var(--space-parent-7) var(--space-parent-11);
		color: var(--color-section-body-text);
		font-size: var(--font-size-parent-faq-answer);
		font-weight: var(--font-weight-parent-regular);
		line-height: var(--line-height-parent-relaxed);
	}

	.faq__card::details-content {
		block-size: var(--space-page-reset);
		overflow: hidden;
		opacity: var(--opacity-entry-start);
		transition:
			block-size var(--duration-parent-faq-expand) var(--easing-parent-in-out),
			opacity var(--duration-parent-faq-expand) var(--easing-parent-in-out),
			content-visibility var(--duration-parent-faq-expand) allow-discrete;
	}

	.faq__card[open]::details-content {
		block-size: auto;
		opacity: var(--opacity-entry-end);
	}

	.faq__answer p {
		margin: var(--space-page-reset);
	}

	.faq__email {
		color: var(--color-brand-primary);
	}

	@media (hover: hover) and (pointer: fine) {
		.faq__card:not([open]) summary:hover .faq__number {
			color: var(--color-parent-number-hover);
		}

		.faq__card:not([open]) summary:hover .faq__question {
			color: var(--color-parent-question-hover);
		}

		.faq__card:not([open]) summary:hover .faq__indicator {
			border-color: var(--color-parent-indicator-hover);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq__card::details-content {
			transition: none;
		}
	}
</style>
