<div
	class="game-panel"
	id="snakeGameContainer"
	data-game-panel
	data-open="false"
	role="dialog"
	aria-modal="true"
	aria-label="Snake game"
	aria-hidden="true"
	hidden
>
	<div class="game-panel__wrapper" id="snake">
		<div class="game-panel__details">
			<span class="score" data-game-score>Score: 0</span>
			<span class="high-score" data-game-high-score>High Score: 0</span>
			<button type="button" class="game-panel__close" data-game-close>
				Close
			</button>
		</div>
		<div
			class="play-board game-panel__board"
			data-game-board
			aria-label="Snake game board"
		></div>
	</div>
</div>

<style>
	.game-panel {
		position: fixed;
		top: var(--game-frame-position);
		left: var(--game-frame-position);
		z-index: var(--game-layer);
		display: none;
		padding: var(--space-parent-3);
		background: var(--color-parent-card-surface);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-card);
		box-shadow: var(--shadow-parent-feature);
		transform: translate(var(--game-center-translation));
	}

	.game-panel[data-open='true'] {
		display: block;
	}

	.game-panel * {
		box-sizing: border-box;
		margin: var(--space-page-reset);
		font-family: var(--font-family-game);
		font-weight: var(--font-weight-parent-semibold);
		font-style: normal;
		font-optical-sizing: auto;
	}

	.game-panel *:not(.game-panel__close) {
		padding: var(--space-page-reset);
	}

	.game-panel__wrapper {
		display: flex;
		flex-direction: column;
		justify-content: center;
		width: var(--game-wrapper-width);
		height: var(--game-wrapper-height);
		overflow: hidden;
		background: var(--color-parent-card-surface);
		border-radius: var(--parent-radius-control);
		transform-origin: center;
		animation: surface-entry var(--duration-snake-entry) ease-in-out forwards;
	}

	.game-panel__details {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-compact-control-gap);
		padding: var(--game-detail-padding-block)
			var(--game-detail-padding-inline);
		color: var(--color-section-body-text);
		font-size: var(--game-detail-font-size);
		font-weight: var(--font-weight-game-detail);
	}

	.game-panel__close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: var(--parent-control-min-height);
		min-height: var(--parent-control-min-height);
		padding: var(--space-parent-2) var(--space-parent-3);
