		font-weight: var(--font-weight-game-detail);
		cursor: pointer;
		background: var(--color-parent-card-hover);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-control);
		transition: all var(--duration-parent-standard) ease;
	}

	.game-panel__close:hover {
		color: var(--color-brand-primary);
		border-color: var(--color-parent-brand-border-soft);
	}

	.game-panel__board {
		display: grid;
		width: var(--game-board-size);
		height: var(--game-board-size);
		background: var(--color-game-board-background);
		grid-template: var(--game-board-grid);
	}

