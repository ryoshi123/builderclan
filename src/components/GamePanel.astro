<div
	class="game-panel"
	id="snakeGameContainer"
	data-game-panel
	data-open="false"
	role="dialog"
	aria-modal="true"
	aria-label="Snake game"
	aria-hidden="true"
	hidden
>
	<div class="game-panel__wrapper" id="snake">
		<div class="game-panel__details">
			<span class="score" data-game-score>Score: 0</span>
			<span class="high-score" data-game-high-score>High Score: 0</span>
			<button type="button" class="game-panel__close" data-game-close>
				Close
			</button>
		</div>
		<div
			class="play-board game-panel__board"
			data-game-board
			aria-label="Snake game board"
		></div>
	</div>
</div>

<style>
