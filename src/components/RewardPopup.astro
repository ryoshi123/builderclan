---
const eggImage = `${import.meta.env.BASE_URL}assets/images/builderclan/easter-egg.svg`;
---

<div
	class="reward-popup"
	id="easterEggPopup"
	data-reward-popup
	data-open="false"
	role="dialog"
	aria-modal="true"
	aria-hidden="true"
	aria-labelledby="reward-popup-title"
	hidden
>
	<div class="reward-popup__content" data-reward-content>
		<img
			src={eggImage}
			alt="Green Easter egg illustration decorated with stars"
			class="reward-popup__egg"
		/>
		<h2 id="reward-popup-title">🚀 Deep Space Explorer Unlocked!</h2>
		<h3>Keep exploring to find more secrets...</h3>
		<p>btw there is 1 hidden game check browser console for more fun</p>
		<p>--Team HellWeek</p>
		<button
			type="button"
			class="reward-popup__close"
			id="closePopup"
			data-reward-close
		>
			Close
		</button>
	</div>
</div>

<style>
	.reward-popup {
		position: fixed;
		top: var(--space-page-reset);
		left: var(--space-page-reset);
		z-index: var(--popup-layer);
		display: none;
		align-items: center;
		justify-content: center;
		width: var(--popup-viewport-width);
		height: var(--popup-viewport-height);
		background: var(--color-popup-backdrop);
	}

	.reward-popup[data-open='true'] {
		display: flex;
	}

	.reward-popup__content {
		position: relative;
		z-index: var(--popup-content-layer);
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: var(--popup-content-max-width);
		padding: var(--space-parent-8);
		color: var(--color-section-body-text);
		font-size: var(--font-size-parent-sm);
		text-align: center;
		background: var(--color-parent-card-surface);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-feature);
		box-shadow: var(--shadow-parent-feature);
		animation: surface-entry var(--duration-parent-section-entry) var(--easing-parent-in-out);
	}

	.reward-popup__content h2 {
		margin: var(--space-parent-4) var(--space-page-reset)
			var(--space-parent-2);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-parent-2xl);
		line-height: var(--line-height-parent-tight);
	}

	.reward-popup__content h3,
	.reward-popup__content p {
		margin: var(--space-parent-2) var(--space-page-reset)
			var(--space-page-reset);
		font-weight: var(--font-weight-parent-regular);
		line-height: var(--line-height-parent-relaxed);
	}

	.reward-popup__egg {
		width: var(--popup-egg-size);
		margin-bottom: var(--space-parent-4);
		animation: popup-egg-bounce var(--duration-popup-egg-bounce) infinite alternate;
	}

	.reward-popup__close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: var(--parent-control-min-height);
		min-height: var(--parent-control-min-height);
		margin-top: var(--space-parent-4);
		padding: var(--space-parent-3) var(--space-parent-5);
		color: var(--color-parent-card-surface);
		font-family: inherit;
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-semibold);
		cursor: pointer;
		background: var(--color-brand-primary);
		border: none;
		border-radius: var(--parent-radius-pill);
		box-shadow: var(--shadow-parent-button);
		transition: all var(--duration-parent-standard) ease;
	}

	.reward-popup__close:hover {
		background: var(--color-parent-brand-hover);
		box-shadow: var(--shadow-parent-button-hover);
		transform: scale(var(--parent-button-hover-scale));
	}
</style>
