---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" data-reveal="fade-up">
	<p>&copy; {currentYear} BuilderClan AISAT. All rights reserved.</p>
	<button
		type="button"
		class="site-footer__hell-week"
		id="hell"
		data-game-unlock
	>
		Team Hell Week
	</button>
</footer>

<style>
	.site-footer {
		padding: var(--space-footer-block);
		color: var(--color-footer-text);
		font-size: var(--font-size-card-copy);
		line-height: var(--line-height-feature-copy);
		text-align: center;
		background: var(--color-page-background);
	}

	.site-footer p,
	.site-footer__hell-week { margin: var(--space-page-reset); }

	.site-footer__hell-week {
		display: block;
		width: var(--section-full-width);
		min-height: var(--control-min-tap-size);
		padding: var(--space-compact-control-gap);
		color: inherit;
		font: inherit;
		line-height: inherit;
		text-align: center;
		appearance: none;
		cursor: pointer;
		background: var(--color-clear-surface);
		border: none;
		border-radius: var(--radius-action-standard);
		transition: color var(--duration-button-standard) var(--easing-parent-standard);
	}

	.site-footer__hell-week:hover { color: var(--color-brand-primary); }
</style>
