---
import { discordInviteUrl } from '../data/links';
import { diagonalArrowPath } from '../data/icons';

const logoSource = `${import.meta.env.BASE_URL}assets/images/builderclan/builderLogoAISAT.svg`;
---

<section class="hero" id="hero">
	<div class="hero__ambient" aria-hidden="true"></div>
	<div class="hero__content">
		<div class="hero__text">
			<h1 class="hero__title" data-hero-item="title">
				<span>BuilderClan</span> AISAT
			</h1>
			<p class="hero__subtitle" data-hero-item="copy">
				Join the BuilderClan AISAT community, where creativity meets action.
				Whether you’re a coder, designer, or innovator, this is your space to
				collaborate, learn, and create projects that make an impact. Let’s build
				the future together!
			</p>
			<div class="hero__actions" data-hero-item="actions">
				<a
					href={discordInviteUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="hero__button hero__button--primary"
				>
					<span>Get Started</span>
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d={diagonalArrowPath} />
					</svg>
				</a>
				<a href="#about" class="hero__button hero__button--secondary">Learn More</a>
			</div>
		</div>

		<div class="hero__visual">
			<div class="hero__visual-glow" aria-hidden="true"></div>
			<img
				src={logoSource}
				alt="BuilderClan AISAT logo"
				class="hero__logo"
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		min-height: var(--parent-hero-min-height);
		padding: var(--space-parent-hero-top) var(--space-page-reset)
			var(--space-parent-hero-bottom);
		overflow: hidden;
		color: var(--color-text-on-dark);
		scroll-margin-top: var(--space-section-scroll-offset);
		background: var(--color-page-background);
	}

	.hero__ambient,
	.hero__visual-glow {
		position: absolute;
		pointer-events: none;
		background: var(--background-parent-ambient);
		filter: blur(var(--parent-menu-blur));
	}

	.hero__ambient {
		top: var(--space-parent-section-block);
		left: var(--game-frame-position);
		width: min(var(--section-full-width), var(--parent-hero-glow-width));
		height: var(--parent-hero-glow-height);
		opacity: var(--parent-ambient-opacity);
		transform: translateX(var(--parent-center-x));
	}

	.hero__content {
		position: relative;
		z-index: var(--parent-content-z);
		display: grid;
		grid-template-columns: var(--parent-hero-grid-columns);
		align-items: center;
		width: var(--section-full-width);
		max-width: var(--parent-container-max-width);
		margin: var(--space-page-reset) var(--space-centered);
		padding-inline: var(--space-parent-hero-container-inline);
		gap: var(--space-parent-hero-content-gap);
	}

	.hero__text {
		grid-column: var(--parent-hero-text-column);
		padding-inline: var(--space-parent-2);
	}

	.hero__title {
		margin: var(--space-page-reset) var(--space-page-reset)
			var(--space-parent-6);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-parent-hero);
		font-weight: var(--font-weight-parent-extrabold);
		line-height: var(--line-height-parent-hero);
		letter-spacing: var(--letter-spacing-parent-tight);
		animation: parent-hero-entry var(--duration-parent-hero-entry)
			var(--easing-parent-in-out) var(--duration-parent-stagger) both;
	}

	.hero__title span {
		color: var(--color-brand-primary);
		text-shadow: var(--shadow-parent-button-hover);
	}

	.hero__subtitle {
		max-width: var(--parent-hero-copy-max-width);
		margin: var(--space-page-reset) var(--space-page-reset)
			var(--space-parent-8);
		color: var(--color-section-body-text);
		font-family: var(--font-family-page);
		font-size: var(--font-size-parent-section-copy);
		font-weight: var(--font-weight-parent-regular);
		line-height: var(--line-height-parent-relaxed);
		animation: parent-hero-entry var(--duration-parent-hero-entry)
			var(--easing-parent-in-out) var(--duration-parent-stagger-2) both;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-parent-4);
		animation: parent-hero-entry var(--duration-parent-hero-entry)
			var(--easing-parent-in-out) var(--duration-parent-stagger-3) both;
	}

	.hero__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: var(--parent-control-min-height);
		padding: var(--space-parent-3-5) var(--space-parent-7);
		gap: var(--space-parent-2);
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-semibold);
		text-decoration: none;
		border-radius: var(--parent-radius-pill);
		transition: all var(--duration-parent-standard) ease;
	}

	.hero__button svg {
		width: var(--space-parent-4);
		height: var(--space-parent-4);
		fill: none;
		stroke: currentColor;
		stroke-width: var(--parent-focus-ring-width);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.hero__button--primary {
		color: var(--color-parent-card-surface);
		background: var(--color-brand-primary);
		box-shadow: var(--shadow-parent-button);
	}

	.hero__button--secondary {
		padding-inline: var(--space-parent-6);
		color: var(--color-text-on-dark);
		font-weight: var(--font-weight-parent-medium);
		background: var(--color-parent-card-surface);
		border: var(--parent-border-width) solid var(--color-parent-border);
	}

	.hero__visual {
		position: relative;
		display: flex;
		grid-column: var(--parent-hero-visual-column);
		align-items: center;
		justify-content: center;
		min-height: var(--parent-hero-visual-min-height);
		padding-block: var(--space-parent-hero-visual-block);
		transform: translateY(var(--parent-hero-visual-offset-y));
	}

	.hero__visual-glow {
		width: var(--parent-hero-logo-width);
		height: var(--parent-hero-logo-width);
		opacity: var(--parent-menu-visible-opacity);
	}

	.hero__logo {
		position: relative;
		z-index: var(--parent-content-z);
		width: var(--parent-hero-logo-width);
		height: auto;
		object-fit: contain;
		filter: drop-shadow(var(--shadow-parent-logo));
		animation: parent-logo-entry var(--duration-parent-logo-entry)
			var(--easing-parent-out) var(--duration-parent-menu) both;
	}

	@media (hover: hover) and (pointer: fine) {
		.hero__button:hover {
			transform: scale(var(--parent-button-hover-scale));
		}

		.hero__button:active {
			transform: scale(var(--parent-button-active-scale));
		}

		.hero__button--primary:hover {
			background: var(--color-parent-brand-hover);
			box-shadow: var(--shadow-parent-button-hover);
		}

		.hero__button--secondary:hover {
			background: var(--color-parent-border);
			border-color: var(--color-parent-border-hover);
		}
	}
</style>
