---
import { navigationLinks } from '../data/navigation';

const logoSource =
	import.meta.env.BASE_URL + 'assets/images/builderclan/LogoShort.svg';
---

<header class="site-header">
	<div class="site-header__inner">
		<a
			href="#hero"
			class="site-header__mark-link"
			aria-label="Go to the BuilderClan AISAT opening section"
		>
			<img
				src={logoSource}
				alt="BuilderClan logo"
				class="site-header__mark"
			/>
		</a>

		<nav class="site-header__links" aria-label="Primary navigation">
			{
				navigationLinks.map(({ label, href, external }) => (
					<a
						href={href}
						target={external ? '_blank' : undefined}
						rel={external ? 'noopener noreferrer' : undefined}
					>
						{label}
					</a>
				))
			}
		</nav>

		<button
			type="button"
			class="site-header__toggle"
			data-navigation-toggle
			data-open-label="Close navigation menu"
			aria-label="Open navigation menu"
			aria-controls="mobile-navigation"
			aria-expanded="false"
		>
			<span class="site-header__toggle-line site-header__toggle-line--top"></span>
			<span class="site-header__toggle-line site-header__toggle-line--middle"></span>
			<span class="site-header__toggle-line site-header__toggle-line--bottom"></span>
		</button>
	</div>

	<nav
		class="site-header__overlay"
		id="mobile-navigation"
		data-navigation-overlay
		aria-label="Mobile navigation"
		aria-hidden="true"
		inert
		data-open="false"
	>
		{
			navigationLinks.map(({ label, href, external }) => (
				<a
					href={href}
					target={external ? '_blank' : undefined}
					rel={external ? 'noopener noreferrer' : undefined}
				>
					{label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header,
	.site-header * {
		box-sizing: border-box;
	}

	.site-header {
		position: fixed;
		top: var(--space-page-reset);
		left: var(--space-page-reset);
		z-index: var(--navigation-layer);
		width: var(--navigation-width);
		padding: var(--space-navigation-pill-top-gap) var(--space-page-reset)
			var(--space-page-reset);
		pointer-events: none;
		font-family: var(--font-family-page);
		font-weight: var(--font-weight-page-default);
		font-style: normal;
		line-height: var(--line-height-page);
		background: var(--color-clear-surface);
	}

	.site-header__inner {
		position: relative;
		z-index: var(--navigation-pill-layer);
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: var(--navigation-content-width);
		max-width: var(--navigation-content-max-width);
		margin: var(--space-page-reset) var(--space-centered);
		padding: var(--space-navigation-pill-block)
			var(--space-navigation-pill-inline);
		gap: var(--space-navigation-content-gap);
		pointer-events: auto;
		background: var(--color-navigation-pill-surface);
		border-radius: var(--navigation-pill-radius);
		box-shadow: var(--shadow-navigation-pill);
		backdrop-filter: none;
	}

	.site-header__mark-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--control-min-tap-size);
		height: var(--control-min-tap-size);
		flex: none;
		border-radius: var(--radius-action-standard);
	}

	.site-header__mark {
		width: var(--space-centered);
		height: var(--navigation-logo-height);
	}

	.site-header__mark-link:hover .site-header__mark {
		animation: site-header-logo-pop var(--duration-navigation-logo-pop) ease forwards;
	}

	@keyframes site-header-logo-pop {
		from {
			transform: scale(var(--navigation-logo-start-scale));
			opacity: var(--navigation-logo-start-opacity);
		}

		to {
			transform: scale(var(--navigation-logo-end-scale));
			opacity: var(--navigation-logo-end-opacity);
		}
	}

	.site-header__links {
		display: var(--navigation-links-display);
		align-items: center;
		gap: var(--space-navigation-link-gap);
	}

	.site-header__links a {
		position: relative;
		display: flex;
		color: var(--color-text-on-dark);
		font-weight: var(--font-weight-section-heading);
		text-decoration: none;
		transition: color var(--duration-navigation-overlay-slide) ease;
	}

	.site-header__links a:hover {
		color: var(--color-brand-primary);
	}

	.site-header__toggle {
		position: relative;
		display: var(--navigation-toggle-display);
		width: var(--control-min-tap-size);
		height: var(--control-min-tap-size);
		flex: none;
		padding: var(--space-page-reset);
		color: var(--color-brand-primary);
		cursor: pointer;
		background: var(--color-navigation-toggle-surface);
		border: var(--navigation-toggle-border-width) solid
			var(--color-navigation-toggle-border);
		border-radius: var(--radius-action-standard);
		transition:
			color var(--duration-navigation-toggle-morph) ease,
			background-color var(--duration-navigation-toggle-morph) ease,
			transform var(--duration-navigation-toggle-morph) ease;
	}

	.site-header__toggle:active {
		transform: scale(var(--navigation-toggle-pressed-scale));
	}

	.site-header__toggle[aria-expanded='true'] {
		color: var(--color-page-background);
		background: var(--color-brand-primary);
	}

	.site-header__toggle-line {
		position: absolute;
		top: var(--navigation-toggle-line-center);
		left: var(--navigation-toggle-line-center);
		width: var(--navigation-toggle-line-width);
		height: var(--navigation-toggle-line-thickness);
		background: currentColor;
		border-radius: var(--radius-join-pill);
		transition:
			transform var(--duration-navigation-toggle-morph) ease,
			opacity var(--duration-navigation-toggle-morph) ease;
	}

	.site-header__toggle-line--top {
		transform: var(--navigation-toggle-line-top-closed);
	}

	.site-header__toggle-line--middle {
		transform: var(--navigation-toggle-line-middle-closed);
	}

	.site-header__toggle-line--bottom {
		transform: var(--navigation-toggle-line-bottom-closed);
	}

	.site-header__toggle[aria-expanded='true']
		.site-header__toggle-line--top {
		transform: var(--navigation-toggle-line-top-open);
	}

	.site-header__toggle[aria-expanded='true']
		.site-header__toggle-line--middle {
		opacity: var(--opacity-entry-start);
	}

	.site-header__toggle[aria-expanded='true']
		.site-header__toggle-line--bottom {
		transform: var(--navigation-toggle-line-bottom-open);
	}

	.site-header__overlay {
		position: fixed;
		top: var(--navigation-overlay-top);
		left: var(--navigation-overlay-closed-position);
		z-index: var(--navigation-overlay-layer);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-start;
		width: var(--navigation-width);
		height: var(--navigation-overlay-height);
		padding: var(--space-navigation-menu-top)
			var(--space-navigation-menu-inline)
			var(--space-navigation-menu-bottom);
		gap: var(--space-navigation-menu-gap);
		opacity: var(--navigation-overlay-opacity);
		pointer-events: none;
		background: var(--color-mobile-navigation-backdrop);
		transition: left var(--duration-navigation-overlay-slide) ease;
	}

	.site-header__overlay[data-open='true'] {
		left: var(--navigation-overlay-open-position);
		pointer-events: auto;
	}

	.site-header__overlay a {
		display: flex;
		align-items: center;
		width: var(--navigation-menu-link-width);
		max-width: var(--navigation-menu-link-max-width);
		min-height: var(--navigation-menu-link-min-height);
		padding-inline: var(--space-navigation-menu-link-inline);
		color: var(--color-brand-primary);
		font-size: var(--font-size-subsection-heading);
		font-weight: var(--font-weight-section-heading);
		text-decoration: none;
		border-radius: var(--radius-action-standard);
		transition:
			color var(--duration-navigation-toggle-morph) ease,
			background-color var(--duration-navigation-toggle-morph) ease,
			transform var(--duration-navigation-toggle-morph) ease;
	}

	.site-header__overlay a:hover,
	.site-header__overlay a:focus-visible {
		color: var(--color-text-on-dark);
		background: var(--color-navigation-menu-link-hover);
	}

	.site-header__overlay a:active {
		transform: scale(var(--navigation-menu-link-pressed-scale));
	}
</style>
