---
import { navigationLinks } from '../data/navigation';

const logoSource =
	import.meta.env.BASE_URL + 'assets/images/builderclan/LogoShort.svg';
const joinLink = navigationLinks.find(({ label }) => label === 'Join');
const hallOfFameLink = navigationLinks.find(({ label }) => label === 'Hall of Fame');
const primaryLinks = navigationLinks.filter(
	({ label }) => label !== 'Join' && label !== 'Hall of Fame',
);
const pageLinks = [hallOfFameLink, joinLink].filter(
	(link): link is (typeof navigationLinks)[number] => Boolean(link),
);
const isHomePage =
	Astro.url.pathname === import.meta.env.BASE_URL ||
	Astro.url.pathname === import.meta.env.BASE_URL + 'index.html';
const isHallOfFamePage =
	Astro.url.pathname === import.meta.env.BASE_URL + 'hall-of-fame/' ||
	Astro.url.pathname === import.meta.env.BASE_URL + 'hall-of-fame/index.html';
const navigationHref = (href: string) => {
	if (href.startsWith('#') && !isHomePage) return import.meta.env.BASE_URL + href;
	if (href === '/hall-of-fame/') return import.meta.env.BASE_URL + 'hall-of-fame/';
	return href;
};
---

<header class="site-header" data-site-header>
	<div class="site-header__frame">
		<div class="site-header__inner">
			<a
				href={navigationHref('#hero')}
				class="site-header__mark-link"
				aria-label="Go to the BuilderClan AISAT opening section"
			>
				<img
					src={logoSource}
					alt="BuilderClan logo"
					class="site-header__mark"
				/>
			</a>

			<nav class="site-header__links" aria-label="Primary navigation">
				{
					primaryLinks.map(({ label, href, external }) => (
						<a
							href={navigationHref(href)}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener noreferrer' : undefined}
							data-navigation-link
							data-navigation-section-link
						>
							{label}
						</a>
					))
				}
			</nav>

			<div class="site-header__page-links">
				{
					pageLinks.map(({ label, href, external }) =>
						label === 'Join' ? (
							<a
								class="site-header__join"
								href={navigationHref(href)}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
								data-navigation-link
							>
								<span>{label}</span>
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<path d="M7 17 17 7M7 7h10v10" />
								</svg>
							</a>
						) : (
							<a
								class="site-header__page-link"
								href={navigationHref(href)}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
								aria-current={isHallOfFamePage ? 'page' : undefined}
								data-navigation-link
							>
								<span>{label}</span>
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<path d="M7 17 17 7M7 7h10v10" />
								</svg>
							</a>
						)
					)
				}
			</div>

			<button
				type="button"
				class="site-header__toggle"
				data-navigation-toggle
				data-open-label="Close navigation menu"
				aria-label="Open navigation menu"
				aria-controls="mobile-navigation"
				aria-expanded="false"
			>
				<span class="site-header__toggle-line site-header__toggle-line--top"></span>
				<span class="site-header__toggle-line site-header__toggle-line--middle"></span>
				<span class="site-header__toggle-line site-header__toggle-line--bottom"></span>
			</button>
		</div>

		<nav
			class="site-header__overlay"
			id="mobile-navigation"
			data-navigation-overlay
			aria-label="Mobile navigation"
			aria-hidden="true"
			inert
			data-open="false"
		>
			{
				primaryLinks.map(({ label, href, external }) => (
					<a
						href={navigationHref(href)}
						target={external ? '_blank' : undefined}
						rel={external ? 'noopener noreferrer' : undefined}
						data-navigation-link
						data-navigation-section-link
					>
						{label}
					</a>
				))
			}
			{
				pageLinks.map(({ label, href, external }) =>
					label === 'Join' ? (
						<div class="site-header__overlay-join">
							<a
								href={navigationHref(href)}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
								data-navigation-link
							>
								<span>{label}</span>
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<path d="M7 17 17 7M7 7h10v10" />
								</svg>
							</a>
						</div>
					) : (
						<a
							class="site-header__overlay-page-link"
							href={navigationHref(href)}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener noreferrer' : undefined}
							aria-current={isHallOfFamePage ? 'page' : undefined}
							data-navigation-link
						>
							<span>{label}</span>
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<path d="M7 17 17 7M7 7h10v10" />
							</svg>
						</a>
					)
				)
			}
		</nav>
	</div>
</header>

<style>
	.site-header,
	.site-header * {
		box-sizing: border-box;
	}

	.site-header {
		position: fixed;
		top: var(--space-parent-header-top);
		left: var(--game-frame-position);
		z-index: var(--parent-header-z);
		width: var(--parent-header-width);
		max-width: var(--parent-header-max-width);
		pointer-events: none;
		font-family: var(--font-family-page);
		transform: translateX(var(--parent-center-x));
	}

	.site-header__frame {
		position: relative;
		width: var(--section-full-width);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: var(--section-full-width);
		padding: var(--space-parent-header-block) var(--space-parent-header-inline);
		pointer-events: auto;
		background: var(--color-parent-header-rest);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-pill);
		box-shadow: var(--shadow-parent-header-rest);
		backdrop-filter: blur(var(--parent-header-blur));
		transition:
			background-color var(--duration-parent-standard) ease,
			border-color var(--duration-parent-standard) ease,
			box-shadow var(--duration-parent-standard) ease;
	}

	.site-header[data-scrolled='true'] .site-header__inner {
		background: var(--color-parent-header-scrolled);
		border-color: var(--color-parent-border-scrolled);
		box-shadow: var(--shadow-parent-header-scrolled);
	}

	.site-header__mark-link {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: var(--parent-control-min-height);
		min-height: var(--parent-control-min-height);
		border-radius: var(--parent-radius-control);
	}

	.site-header__mark {
		width: var(--parent-header-logo-width);
		height: auto;
		transition: transform var(--duration-parent-standard) ease;
	}

	.site-header__mark-link:hover .site-header__mark {
		transform: scale(var(--parent-logo-hover-scale));
	}

	.site-header__links {
		display: var(--navigation-links-display);
		align-items: center;
		padding: var(--space-parent-1-5);
		gap: var(--space-parent-1);
		background: var(--color-parent-nav-track);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-pill);
	}

	.site-header__page-links {
		display: var(--parent-header-join-display);
		align-items: center;
		gap: var(--space-parent-4);
	}

	.site-header__links a,
	.site-header__page-link,
	.site-header__join,
	.site-header__overlay a {
		text-decoration: none;
	}

	.site-header__links a {
		padding: var(--space-parent-1-5) var(--space-parent-4);
		color: var(--color-section-body-text);
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-medium);
		border-radius: var(--parent-radius-pill);
		transition: all var(--duration-parent-standard) ease;
	}

	.site-header__links a:hover {
		color: var(--color-text-on-dark);
		background: var(--color-parent-card-hover);
	}

	.site-header__page-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-parent-1-5);
		padding: var(--space-parent-2) var(--space-page-reset);
		color: var(--color-section-body-text);
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-medium);
		border-radius: var(--parent-radius-pill);
		transition: all var(--duration-parent-standard) ease;
	}

	.site-header__page-link svg {
		width: var(--space-parent-3-5);
		height: var(--space-parent-3-5);
		fill: none;
		stroke: currentColor;
		stroke-width: var(--parent-focus-ring-width);
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform var(--duration-parent-control) var(--easing-parent-out);
	}

	.site-header__page-link:hover,
	.site-header__page-link:focus-visible,
	.site-header__page-link[aria-current='page'] {
		color: var(--color-brand-primary);
	}

	.site-header__page-link:hover svg,
	.site-header__page-link:focus-visible svg {
		transform: translateX(var(--parent-arrow-hover-x));
	}

	.site-header__links a[data-active='true'] {
		color: var(--color-parent-card-surface);
		font-weight: var(--font-weight-parent-semibold);
		background: var(--color-brand-primary);
		box-shadow: var(--shadow-parent-active-link);
	}

	.site-header__join {
		display: var(--parent-header-join-display);
		align-items: center;
		min-height: var(--parent-control-min-height);
		padding: var(--space-parent-2) var(--space-parent-4);
		gap: var(--space-parent-1-5);
		color: var(--color-parent-card-surface);
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-semibold);
		background: var(--color-brand-primary);
		border-radius: var(--parent-radius-pill);
		box-shadow: var(--shadow-parent-card);
		transition: all var(--duration-parent-standard) ease;
	}

	.site-header__join svg,
	.site-header__overlay-join svg,
	.site-header__overlay-page-link svg {
		width: var(--space-parent-3-5);
		height: var(--space-parent-3-5);
		fill: none;
		stroke: currentColor;
		stroke-width: var(--parent-focus-ring-width);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.site-header__join:hover {
		background: var(--color-parent-brand-hover);
		box-shadow: var(--shadow-parent-button);
	}

	.site-header__toggle {
		position: relative;
		display: var(--navigation-toggle-display);
		width: var(--parent-control-min-height);
		height: var(--parent-control-min-height);
		align-items: center;
		justify-content: center;
		padding: var(--space-page-reset);
		color: var(--color-brand-primary);
		cursor: pointer;
		background: var(--color-parent-card-hover);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-pill);
		transition: all var(--duration-parent-menu) ease;
	}

	.site-header__toggle[aria-expanded='true'] {
		color: var(--color-parent-card-surface);
		background: var(--color-brand-primary);
	}

	.site-header__toggle-line {
		position: absolute;
		top: var(--navigation-toggle-line-center);
		left: var(--navigation-toggle-line-center);
		width: var(--parent-menu-icon-size);
		height: var(--navigation-toggle-line-thickness);
		background: currentColor;
		border-radius: var(--parent-radius-pill);
		transition:
			transform var(--duration-parent-menu) ease,
			opacity var(--duration-parent-menu) ease;
	}

	.site-header__toggle-line--top {
		transform: var(--navigation-toggle-line-top-closed);
	}

	.site-header__toggle-line--middle {
		transform: var(--navigation-toggle-line-middle-closed);
	}

	.site-header__toggle-line--bottom {
		transform: var(--navigation-toggle-line-bottom-closed);
	}

	.site-header__toggle[aria-expanded='true'] .site-header__toggle-line--top {
		transform: var(--navigation-toggle-line-top-open);
	}

	.site-header__toggle[aria-expanded='true'] .site-header__toggle-line--middle {
		opacity: var(--opacity-entry-start);
	}

	.site-header__toggle[aria-expanded='true'] .site-header__toggle-line--bottom {
		transform: var(--navigation-toggle-line-bottom-open);
	}

	.site-header__overlay {
		position: absolute;
		top: calc(var(--section-full-width) + var(--space-parent-2));
		left: var(--space-page-reset);
		display: flex;
		flex-direction: column;
		width: var(--section-full-width);
		padding: var(--space-parent-5);
		gap: var(--space-parent-2);
		opacity: var(--parent-menu-hidden-opacity);
		visibility: hidden;
		pointer-events: none;
		background: var(--color-parent-menu-surface);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-menu);
		box-shadow: var(--shadow-parent-header-rest);
		backdrop-filter: blur(var(--parent-menu-blur));
		transform: translateY(var(--parent-menu-closed-offset))
			scale(var(--parent-menu-scale-closed));
		transform-origin: top center;
		transition:
			opacity var(--duration-parent-menu) var(--easing-parent-out),
			transform var(--duration-parent-menu) var(--easing-parent-out),
			visibility var(--duration-parent-menu) var(--easing-parent-out);
	}

	.site-header__overlay[data-open='true'] {
		opacity: var(--parent-menu-visible-opacity);
		visibility: visible;
		pointer-events: auto;
		transform: translateY(var(--space-page-reset))
			scale(var(--parent-menu-scale-open));
	}

	.site-header__overlay > a {
		display: flex;
		align-items: center;
		min-height: var(--parent-control-min-height);
		padding: var(--space-parent-3) var(--space-parent-4);
		color: var(--color-section-body-text);
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-medium);
		border-radius: var(--parent-radius-control);
		transition: all var(--duration-parent-standard) ease;
	}

	.site-header__overlay > a:hover,
	.site-header__overlay > a:focus-visible {
		color: var(--color-text-on-dark);
		background: var(--color-parent-border);
	}

	.site-header__overlay > a[data-active='true'] {
		color: var(--color-parent-card-surface);
		font-weight: var(--font-weight-parent-semibold);
		background: var(--color-brand-primary);
	}

	.site-header__overlay-page-link {
		justify-content: space-between;
	}

	.site-header__overlay-page-link svg {
		transition: transform var(--duration-parent-control) var(--easing-parent-out);
	}

	.site-header__overlay-page-link:hover svg,
	.site-header__overlay-page-link:focus-visible svg {
		transform: translateX(var(--parent-arrow-hover-x));
	}

	.site-header__overlay-page-link[aria-current='page'] {
		color: var(--color-brand-primary);
		font-weight: var(--font-weight-parent-semibold);
	}

	.site-header__overlay-join {
		padding-top: var(--space-parent-2);
		margin-top: var(--space-parent-1);
		border-top: var(--parent-border-width) solid var(--color-parent-border);
	}

	.site-header__overlay-join a {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: var(--parent-control-min-height);
		padding: var(--space-parent-3) var(--space-parent-4);
		gap: var(--space-parent-2);
		color: var(--color-parent-card-surface);
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-semibold);
		background: var(--color-brand-primary);
		border-radius: var(--parent-radius-control);
		box-shadow: var(--shadow-parent-card);
	}
</style>
