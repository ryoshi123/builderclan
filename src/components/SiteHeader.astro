---
import { navigationLinks } from '../data/navigation';

const logoSource = `${import.meta.env.BASE_URL}assets/images/builderclan/LogoShort.svg`;
---

<header class="site-header">
	<div class="site-header__inner">
		<div class="site-header__brand">
			<img
				src={logoSource}
				alt="BuilderClan Logo"
				class="site-header__mark"
			/>
			<a href="#hero" class="site-header__brand-link">
				<span class="site-header__brand-first">Builder</span><span
					class="site-header__brand-second">Clan</span
				>
			</a>
		</div>

		<nav class="site-header__links" aria-label="Primary navigation">
			{
				navigationLinks.map(({ label, href, external }) => (
					<a
						href={href}
						target={external ? '_blank' : undefined}
						rel={external ? 'noopener noreferrer' : undefined}
					>
						{label}
					</a>
				))
			}
		</nav>

		<button
			type="button"
			class="site-header__toggle"
			data-navigation-toggle
			data-open-label="Close navigation menu"
			aria-label="Open navigation menu"
			aria-controls="mobile-navigation"
			aria-expanded="false"
		>
			☰
		</button>
	</div>

	<nav
		class="site-header__overlay"
		id="mobile-navigation"
		data-navigation-overlay
		aria-label="Mobile navigation"
		aria-hidden="true"
		inert
		data-open="false"
	>
		{
			navigationLinks.map(({ label, href, external }) => (
				<a
					href={href}
					target={external ? '_blank' : undefined}
					rel={external ? 'noopener noreferrer' : undefined}
				>
					{label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header,
	.site-header * { box-sizing: border-box; }

	.site-header {
		position: fixed;
		top: var(--space-page-reset);
		left: var(--space-page-reset);
		z-index: var(--navigation-layer);
		width: var(--navigation-width);
		padding-top: var(--space-navigation-pill-top-gap);
		pointer-events: none;
		font-family: var(--font-family-page);
		font-weight: var(--font-weight-navigation);
		line-height: var(--line-height-page);
	}

	.site-header__inner {
		position: relative;
		z-index: var(--navigation-pill-layer);
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(var(--navigation-content-max-width), var(--navigation-content-width));
		margin: var(--space-page-reset) var(--space-centered);
		padding: var(--space-navigation-pill-block) var(--space-navigation-pill-inline);
		pointer-events: auto;
		background: var(--color-navigation-pill-surface);
		border: var(--card-border-width) solid var(--color-standard-border);
		border-radius: var(--navigation-pill-radius);
		box-shadow: var(--shadow-navigation-pill);
		backdrop-filter: blur(var(--navigation-backdrop-blur));
		transition:
			background-color var(--duration-navigation-scroll) var(--easing-parent-standard),
			border-color var(--duration-navigation-scroll) var(--easing-parent-standard),
			box-shadow var(--duration-navigation-scroll) var(--easing-parent-standard);
	}

	.site-header[data-scrolled='true'] .site-header__inner {
		background: var(--color-navigation-pill-scrolled);
		border-color: var(--color-navigation-scrolled-border);
	}

	.site-header__brand {
		display: flex;
		align-items: center;
		gap: var(--space-navigation-brand-gap);
		font-size: var(--font-size-navigation-brand);
		font-weight: var(--font-weight-section-heading);
		line-height: var(--line-height-icon);
	}

	.site-header__mark {
		width: var(--space-centered);
		height: var(--navigation-logo-height);
		transition:
			transform var(--duration-navigation-logo-pop) var(--easing-parent-out),
			opacity var(--duration-navigation-logo-pop) var(--easing-parent-out);
	}

	.site-header__mark:hover { transform: scale(var(--scale-social-hover)); }

	.site-header__brand-link {
		color: var(--color-text-on-dark);
		font-size: var(--font-size-navigation-brand);
		font-weight: var(--font-weight-section-heading);
		text-decoration: none;
	}

	.site-header__brand-first { color: var(--color-text-on-dark); }
	.site-header__brand-second { color: var(--color-brand-primary); }

	.site-header__brand-link span {
		transition: color var(--duration-button-standard) var(--easing-parent-standard);
	}

	.site-header__brand-link:hover .site-header__brand-first { color: var(--color-brand-primary); }
	.site-header__brand-link:hover .site-header__brand-second { color: var(--color-text-on-dark); }

	.site-header__links {
		display: var(--navigation-links-display);
		align-items: center;
		gap: var(--space-navigation-link-gap);
	}

	.site-header__links a {
		display: flex;
		color: var(--color-supporting-text);
		font-size: var(--font-size-action-label);
		font-weight: var(--font-weight-navigation);
		text-decoration: none;
		transition: color var(--duration-button-standard) var(--easing-parent-standard);
	}

	.site-header__links a:hover,
	.site-header__links a[aria-current='location'] { color: var(--color-brand-primary); }

	.site-header__toggle {
		position: relative;
		display: var(--navigation-toggle-display);
		align-items: center;
		justify-content: center;
		width: var(--control-min-tap-size);
		height: var(--control-min-tap-size);
		padding: var(--space-compact-control-gap);
		color: var(--color-clear-surface);
		font-size: var(--font-size-navigation-toggle);
		line-height: var(--line-height-icon);
		cursor: pointer;
		background: var(--color-interactive-surface);
		border: var(--card-border-width) solid var(--color-standard-border);
		border-radius: var(--radius-round);
		transition:
			background-color var(--duration-button-standard) var(--easing-parent-standard),
			border-color var(--duration-button-standard) var(--easing-parent-standard),
			transform var(--duration-button-standard) var(--easing-parent-standard);
	}

	.site-header__toggle::before {
		position: absolute;
		inset: var(--space-page-reset);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-brand-primary);
		content: '☰';
	}

	.site-header__toggle[aria-expanded='true']::before { content: '×'; }

	.site-header__toggle:hover {
		background: var(--color-input-surface);
		border-color: var(--color-hover-border);
	}

	.site-header__overlay {
		position: fixed;
		top: var(--navigation-overlay-top);
		left: var(--layout-center-position);
		z-index: var(--navigation-overlay-layer);
		display: var(--navigation-overlay-display);
		flex-direction: column;
		width: min(var(--navigation-content-max-width), var(--navigation-content-width));
		height: var(--navigation-overlay-height);
		padding: var(--space-navigation-overlay-inline);
		gap: var(--space-navigation-overlay-gap);
		visibility: hidden;
		opacity: var(--opacity-entry-start);
		pointer-events: none;
		background: var(--color-mobile-navigation-backdrop);
		border: var(--card-border-width) solid var(--color-standard-border);
		border-radius: var(--radius-card-standard);
		box-shadow: var(--shadow-navigation-pill);
		backdrop-filter: blur(var(--navigation-dropdown-blur));
		transform: translate(var(--layout-center-translation), var(--navigation-overlay-closed-position))
			scale(var(--navigation-overlay-closed-scale));
		transition:
			opacity var(--duration-navigation-overlay-slide) var(--easing-parent-out),
			transform var(--duration-navigation-overlay-slide) var(--easing-parent-out),
			visibility var(--duration-navigation-overlay-slide) var(--easing-parent-out);
	}

	.site-header__overlay[data-open='true'] {
		visibility: visible;
		opacity: var(--opacity-entry-end);
		pointer-events: auto;
		transform: translate(var(--layout-center-translation), var(--navigation-overlay-open-position))
			scale(var(--scale-entry-end));
	}

	.site-header__overlay a {
		display: flex;
		align-items: center;
		min-height: var(--control-min-tap-size);
		padding-inline: var(--space-section-intro-offset);
		color: var(--color-supporting-text);
		font-size: var(--font-size-action-label);
		font-weight: var(--font-weight-navigation);
		text-decoration: none;
		border-radius: var(--radius-action-standard);
		transition:
			color var(--duration-button-standard) var(--easing-parent-standard),
			background-color var(--duration-button-standard) var(--easing-parent-standard);
	}

	.site-header__overlay a:hover {
		color: var(--color-brand-primary);
		background: var(--color-interactive-surface);
	}
</style>
