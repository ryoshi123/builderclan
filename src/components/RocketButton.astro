---
const rocketSource = `${import.meta.env.BASE_URL}assets/images/builderclan/rocket.svg`;
---

<button
	type="button"
	class="rocket"
	data-rocket
	aria-label="Reveal the hidden reward"
>
	<span
		class="rocket__icon"
		aria-hidden="true"
		style={`--rocket-icon-source: url("${rocketSource}")`}
	></span>
</button>

<style>
	.rocket {
		position: fixed;
		left: var(--parent-rocket-inline-edge);
		bottom: var(--parent-rocket-block-edge);
		z-index: var(--parent-floating-layer);
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--rocket-control-width);
		height: var(--rocket-control-height);
		padding: var(--space-rocket-control-block) var(--space-rocket-control-inline);
		color: var(--color-rocket-idle);
		font-size: var(--font-size-rocket-control);
		line-height: normal;
		cursor: pointer;
		background: var(--color-clear-surface);
		border: none;
		border-radius: var(--radius-square);
		box-shadow: none;
	}

	.rocket__icon {
		display: inline-block;
		flex: none;
		width: var(--rocket-icon-size);
		height: var(--rocket-icon-size);
		background-color: currentColor;
		mask: var(--rocket-icon-source) center / contain no-repeat;
		-webkit-mask: var(--rocket-icon-source) center / contain no-repeat;
		transform: translateY(var(--rocket-icon-block-offset));
		transition: transform var(--duration-rocket-hover) ease;
	}

	.rocket:hover {
		color: var(--color-rocket-hover);
	}

	.rocket:hover .rocket__icon {
		width: var(--font-size-rocket-control-hover);
		height: var(--font-size-rocket-control-hover);
		transform: translateY(var(--rocket-icon-block-offset))
			scale(var(--scale-rocket-hover));
	}

	.rocket--launching {
		will-change: transform, opacity;
		animation: rocket-flight var(--duration-rocket-flight)
			var(--easing-rocket-flight)
			var(--rocket-flight-fill-mode);
	}

	.rocket--resetting {
		visibility: hidden;
		transform: none;
		opacity: var(--rocket-flight-end-opacity);
		transition: none;
	}
</style>
