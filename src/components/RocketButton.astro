---
const rocketSource = `${import.meta.env.BASE_URL}assets/images/builderclan/rocket.svg`;
---

<button
	type="button"
	class="rocket"
	data-rocket
	aria-label="Reveal the hidden reward"
>
	<span
		class="rocket__icon"
		aria-hidden="true"
		style={`--rocket-icon-source: url("${rocketSource}")`}
	></span>
</button>

<style>
.rocket {
		position: fixed;
		bottom: var(--space-floating-control-block-edge);
		left: var(--space-floating-control-inline-edge);
		z-index: var(--game-layer);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: var(--control-min-tap-size);
		min-height: var(--control-min-tap-size);
		padding: var(--space-compact-control-gap);
		font-size: var(--font-size-rocket-control);
		cursor: pointer;
		background: var(--color-navigation-surface);
		border: var(--card-border-width) solid var(--color-standard-border);
		border-radius: var(--radius-action-standard);
		box-shadow: var(--shadow-button-inverse);
		transition:
			background-color var(--duration-rocket-hover) var(--easing-site-out),
			border-color var(--duration-rocket-hover) var(--easing-site-out);
	}

	.rocket__icon {
		display: inline-block;
		width: var(--rocket-icon-size);
		height: var(--rocket-icon-size);
		color: var(--color-rocket-idle);
		font-size: var(--font-size-rocket-control);
		line-height: var(--line-height-icon);
		vertical-align: var(--rocket-icon-baseline-offset);
		background-color: currentColor;
		mask: var(--rocket-icon-source) center / contain no-repeat;
		-webkit-mask: var(--rocket-icon-source) center / contain no-repeat;
		transition: color var(--duration-rocket-hover) var(--easing-site-standard);
	}

	.rocket:hover {
		background: var(--color-raised-card-surface);
		border-color: var(--color-hover-border);
	}

	.rocket:hover .rocket__icon { color: var(--color-rocket-hover); }

	.rocket--launching {
		will-change: transform, opacity;
		animation: rocket-flight var(--duration-rocket-flight) var(--easing-rocket-flight);
	}
</style>
