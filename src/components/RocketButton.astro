---
const rocketSource = `${import.meta.env.BASE_URL}assets/images/builderclan/rocket.svg`;
---

<button
	type="button"
	class="rocket"
	data-rocket
	aria-label="Reveal the hidden reward"
>
	<span
		class="rocket__icon"
		aria-hidden="true"
		style={`--rocket-icon-source: url("${rocketSource}")`}
	></span>
</button>

<style>
	.rocket {
		position: fixed;
		left: var(--parent-rocket-inline-edge);
		bottom: var(--rocket-avoided-block-edge, var(--parent-floating-edge));
		z-index: var(--parent-floating-layer);
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: var(--parent-control-min-height);
		min-height: var(--parent-control-min-height);
		padding: var(--parent-floating-inset);
		color: var(--color-parent-card-surface);
		cursor: pointer;
		background: var(--color-brand-primary);
		border: none;
		border-radius: var(--radius-round);
		box-shadow: var(--shadow-parent-card);
		transition: transform var(--duration-parent-standard) ease;
	}

	.rocket__icon {
		display: inline-block;
		width: var(--social-icon-size);
		height: var(--social-icon-size);
		background-color: currentColor;
		mask: var(--rocket-icon-source) center / contain no-repeat;
		-webkit-mask: var(--rocket-icon-source) center / contain no-repeat;
	}

	.rocket:hover {
		transform: scale(var(--scale-social-hover));
	}

	.rocket--launching {
		will-change: transform, opacity;
		animation: rocket-flight var(--duration-rocket-flight)
			var(--easing-rocket-flight) var(--rocket-flight-fill-mode);
	}

	.rocket--resetting {
		visibility: hidden;
		transform: none;
		opacity: var(--rocket-flight-end-opacity);
		transition: none;
	}
</style>
