---
interface Props {
	inset?: boolean;
}

const { inset = false } = Astro.props;
---

<div class:list={['section-surface', { 'section-surface--inset': inset }]}>
	<slot />
</div>

<style>
	.section-surface {
		position: relative;
		background: var(--color-page-background);
	}

	.section-surface--inset { color: var(--color-text-on-dark); }
</style>
