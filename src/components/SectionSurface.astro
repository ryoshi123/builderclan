---
interface Props {
	inset?: boolean;
}

const { inset = false } = Astro.props;
---

<div class:list={['section-surface', { 'section-surface--inset': inset }]}>
	<slot />
</div>

<style>
	.section-surface {
		background: var(--background-content-surface);
	}

	.section-surface--inset {
		color: var(--color-text-on-dark);
		box-shadow: var(--shadow-section-inset);
		transition:
			transform var(--duration-section-hover) ease,
			box-shadow var(--duration-section-hover) ease;
	}
</style>
