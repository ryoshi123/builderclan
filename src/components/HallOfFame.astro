---
import { members } from '../data/members';

const githubIcon = `${import.meta.env.BASE_URL}assets/images/builderclan/github-mark.svg`;
const linkedinIcon = `${import.meta.env.BASE_URL}assets/images/builderclan/LinkedIn.svg`;
---

<section
	class="hall-of-fame section-jump-target"
	id="hall-of-fame"
	data-reveal="slide-up"
>
	<h3 class="hall-of-fame__heading">Hell Week 14B1 Hall of Fame</h3>
	<div class="hall-of-fame__row-shell" data-member-scroll-shell>
		<div
			class="hall-of-fame__row"
			data-member-scroll-row
			aria-label="Hall of Fame members; scroll horizontally for more"
		>
			{
				members.map((member) => (
					<article class="hall-of-fame__card">
						<img
							src={`${import.meta.env.BASE_URL}${member.photo}`}
							alt={member.name}
							class="hall-of-fame__photo"
						/>
						<h4 class="hall-of-fame__name">{member.name}</h4>
						<p class="hall-of-fame__detail">{member.department}</p>
						<p class="hall-of-fame__detail">{member.project}</p>

						<div class="hall-of-fame__socials">
							<a
								href={member.github}
								target="_blank"
								rel="noopener noreferrer"
							>
								<img
									src={githubIcon}
									alt={`${member.name} on GitHub`}
									class="hall-of-fame__social-icon"
								/>
							</a>
							<a
								href={member.linkedin}
								target="_blank"
								rel="noopener noreferrer"
							>
								<img
									src={linkedinIcon}
									alt={`${member.name} on LinkedIn`}
									class="hall-of-fame__social-icon"
								/>
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
.hall-of-fame {
		position: relative;
		width: min(var(--content-max-width), var(--content-width));
		margin: var(--space-page-reset) var(--space-centered);
		padding: var(--space-hall-section-top) var(--space-page-reset)
			var(--space-hall-section-bottom);
		color: var(--color-text-on-dark);
		text-align: left;
	}

	.hall-of-fame__heading {
		display: block;
		margin: var(--space-page-reset);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-subsection-heading);
		font-weight: var(--font-weight-section-heading);
		line-height: var(--line-height-section-heading);
		letter-spacing: var(--letter-spacing-heading);
	}

	.hall-of-fame__row-shell { position: relative; margin-top: var(--space-content-gap); }

	.hall-of-fame__row-shell::after {
		position: absolute;
		inset-block: var(--space-page-reset);
		inset-inline-end: var(--space-page-reset);
		z-index: var(--member-row-continuation-layer);
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--member-row-continuation-cue-width);
		color: var(--color-brand-primary);
		font-size: var(--font-size-subsection-heading);
		pointer-events: none;
		content: '→';
		opacity: var(--opacity-entry-start);
		background: var(--background-member-row-continuation-cue);
		transition: opacity var(--duration-button-hover) var(--easing-site-standard);
	}

	.hall-of-fame__row-shell[data-scrollable='true'][data-scroll-end='false']::after {
		opacity: var(--opacity-entry-end);
	}

	.hall-of-fame__row {
		display: flex;
		padding: var(--space-hall-row-block) var(--space-page-reset) var(--space-hall-row-bottom);
		overflow-x: auto;
		gap: var(--space-content-gap);
		scroll-padding-inline: var(--space-page-reset);
		scrollbar-width: none;
		scroll-snap-type: x mandatory;
		touch-action: pan-x;
		-webkit-overflow-scrolling: touch;
	}

	.hall-of-fame__card {
		flex: var(--card-flex-fixed);
		width: var(--member-card-width);
		padding: var(--card-padding);
		text-align: center;
		background: var(--card-surface);
		border: var(--card-border-width) solid var(--card-border-color);
		border-radius: var(--card-radius);
		box-shadow: var(--shadow-card-default);
		scroll-snap-align: start;
		scroll-snap-stop: always;
		transition:
			background-color var(--duration-button-standard) var(--easing-site-out),
			border-color var(--duration-button-standard) var(--easing-site-out),
			box-shadow var(--duration-button-standard) var(--easing-site-out);
	}

	.hall-of-fame__photo {
		width: var(--member-photo-size);
		height: var(--member-photo-size);
		margin: var(--space-page-reset) var(--space-centered) var(--space-section-gutter);
		object-fit: cover;
		border-radius: var(--radius-round);
	}

	.hall-of-fame__name {
		margin: var(--space-page-reset) var(--space-page-reset) var(--space-card-title-gap);
		color: var(--color-hall-member-name);
		font-size: var(--font-size-feature-copy);
		font-weight: var(--font-weight-button);
		line-height: var(--line-height-section-heading);
	}

	.hall-of-fame__detail {
		margin: var(--space-page-reset) var(--space-page-reset) var(--space-compact-control-gap);
		opacity: var(--opacity-member-detail);
		color: var(--color-faded-text);
		font-size: var(--font-size-card-copy);
		line-height: var(--line-height-feature-copy);
	}

	.hall-of-fame__socials {
		display: flex;
		justify-content: center;
		margin-top: var(--space-section-gutter);
		gap: var(--space-section-gutter);
	}

	.hall-of-fame__socials a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: var(--control-min-tap-size);
		min-height: var(--control-min-tap-size);
		border-radius: var(--radius-action-standard);
	}

	.hall-of-fame__social-icon {
		width: var(--social-icon-size);
		height: var(--social-icon-size);
		transition: transform var(--duration-button-standard) var(--easing-site-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.hall-of-fame__card:hover {
			background: var(--card-surface-hover);
			border-color: var(--card-hover-border-color);
			box-shadow: var(--shadow-card-hover);
		}
		.hall-of-fame__socials a:hover img { transform: scale(var(--scale-social-hover)); }
	}
</style>
