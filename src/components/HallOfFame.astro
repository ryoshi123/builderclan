---
import { hallOfFameGroups } from '../data/members';
import { diagonalArrowPath } from '../data/icons';

interface Props {
	compact?: boolean;
	page?: boolean;
}

const { compact = false, page = false } = Astro.props;
const hallOfFameUrl = import.meta.env.BASE_URL + 'hall-of-fame/';
const homeUrl = import.meta.env.BASE_URL;
const githubIcon = import.meta.env.BASE_URL + 'assets/images/builderclan/github-mark.svg';
const linkedinIcon = import.meta.env.BASE_URL + 'assets/images/builderclan/LinkedIn.svg';
const sortedGroups = [...hallOfFameGroups].sort((first, second) => second.year - first.year);
---

<section
	class:list={[
		'hall-of-fame',
		'section-jump-target',
		{ 'hall-of-fame--compact': compact, 'hall-of-fame--page': page },
	]}
	id="hall-of-fame"
	data-reveal="fade-up"
>
	<div class="content-container">
		<header class="hall-of-fame__header">
			{page ? (
				<h1>Hall of Fame</h1>
			) : (
				<a class="hall-of-fame__heading-link" href={hallOfFameUrl}>
					<h3>
						Hall of Fame
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path d={diagonalArrowPath} />
						</svg>
					</h3>
				</a>
			)}
			{compact && (
				<p class="section-copy hall-of-fame__description">
					Every year a new group takes on Hell Week. The Hall of Fame keeps a
					record of everyone who has made it through.
				</p>
			)}
		</header>

		{
			page && (
				<>
					<a class="hall-of-fame__back-link" href={homeUrl}>
						Home
					</a>
					<div class="hall-of-fame__groups">
						{sortedGroups.map((group) => (
							<section class="hall-of-fame__group">
								<h2 class="hall-of-fame__group-title">{group.title}</h2>
								<div class="hall-of-fame__row-shell">
									<div
										class="hall-of-fame__row hall-of-fame__row--grid"
										aria-label={group.title + ' Hall of Fame members'}
									>
										{
											group.members.map((member) => (
												<article class="hall-of-fame__card">
													<img
														src={import.meta.env.BASE_URL + member.photo}
														alt={member.name}
														class="hall-of-fame__photo"
													/>
													<h3 class="hall-of-fame__name">{member.name}</h3>
													<p class="hall-of-fame__detail">{member.department}</p>
													<p class="hall-of-fame__detail">{member.project}</p>

													<div class="hall-of-fame__socials">
														<a
															href={member.github}
															target="_blank"
															rel="noopener noreferrer"
														>
															<img
																src={githubIcon}
																alt={member.name + ' on GitHub'}
																class="hall-of-fame__social-icon"
															/>
														</a>
														<a
															href={member.linkedin}
															target="_blank"
															rel="noopener noreferrer"
														>
															<img
																src={linkedinIcon}
																alt={member.name + ' on LinkedIn'}
																class="hall-of-fame__social-icon"
															/>
														</a>
													</div>
												</article>
											))
										}
									</div>
								</div>
							</section>
						))}
					</div>
				</>
			)
		}
	</div>
</section>

<style>
	.hall-of-fame {
		padding: var(--space-parent-section-block) var(--space-page-reset)
			var(--space-parent-hall-bottom);
		color: var(--color-text-on-dark);
		background: var(--color-page-background);
	}

	.hall-of-fame__header {
		max-width: var(--parent-copy-max-width);
		margin: var(--space-page-reset) var(--space-centered)
			var(--space-parent-12);
		text-align: center;
	}

	.hall-of-fame__header h1,
	.hall-of-fame__header h3 {
		margin: var(--space-page-reset);
		color: var(--color-brand-primary);
		font-size: var(--font-size-parent-section-heading);
		font-weight: var(--font-weight-parent-extrabold);
		line-height: var(--line-height-parent-tight);
		letter-spacing: var(--letter-spacing-parent-tight);
	}

	.hall-of-fame--compact .hall-of-fame__header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-parent-heading-bottom);
		margin-bottom: var(--space-page-reset);
	}

	.hall-of-fame__heading-link,
	.hall-of-fame__back-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: inherit;
		text-decoration: none;
	}

	.hall-of-fame__heading-link h3 {
		display: inline-flex;
		align-items: baseline;
		gap: var(--space-parent-2);
	}

	.hall-of-fame__heading-link svg {
		position: relative;
		width: var(--hall-heading-arrow-size);
		height: var(--hall-heading-arrow-size);
		top: var(--hall-heading-arrow-offset);
		fill: none;
		stroke: currentColor;
		stroke-width: var(--parent-focus-ring-width);
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform var(--duration-parent-control) var(--easing-parent-out);
	}

	.hall-of-fame__description {
		margin-inline: var(--space-centered);
		text-align: center;
	}

	.hall-of-fame__back-link {
		min-height: var(--parent-control-min-height);
		padding: var(--space-parent-3-5) var(--space-parent-6);
		color: var(--color-text-on-dark);
		font-size: var(--font-size-parent-sm);
		font-weight: var(--font-weight-parent-medium);
		background: var(--color-parent-card-surface);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-pill);
		transition: all var(--duration-parent-standard) ease;
	}

	.hall-of-fame__back-link:hover,
	.hall-of-fame__back-link:focus-visible {
		color: var(--color-text-on-dark);
		background: var(--color-parent-card-hover);
		border-color: var(--color-parent-brand-border-soft);
	}

	.hall-of-fame__back-link {
		display: flex;
		width: fit-content;
		margin: var(--space-page-reset) var(--space-centered)
			var(--space-parent-12);
	}

	.hall-of-fame__groups {
		display: flex;
		flex-direction: column;
		gap: var(--space-parent-section-block);
	}

	.hall-of-fame__group-title {
		margin: var(--space-page-reset) var(--space-page-reset)
			var(--space-parent-6);
		color: var(--color-brand-primary);
		font-size: var(--font-size-parent-2xl);
		font-weight: var(--font-weight-parent-bold);
		line-height: var(--line-height-parent-tight);
		text-align: center;
	}

	.hall-of-fame__row-shell {
		position: relative;
	}

	.hall-of-fame__row-shell::after {
		position: absolute;
		inset-block-start: var(--space-parent-1);
		inset-block-end: auto;
		inset-inline-end: var(--space-page-reset);
		z-index: var(--member-row-continuation-layer);
		display: var(--parent-member-cue-display);
		align-items: center;
		justify-content: center;
		width: var(--member-row-continuation-cue-width);
		height: var(--parent-control-min-height);
		color: var(--color-brand-primary);
		font-size: var(--font-size-parent-2xl);
		pointer-events: none;
		content: '→';
		opacity: var(--opacity-entry-start);
		background: var(--background-member-row-continuation-cue);
		transition: opacity var(--duration-parent-control) ease;
	}

	.hall-of-fame__row-shell[data-scrollable='true'][data-scroll-end='false']::after {
		opacity: var(--opacity-entry-end);
	}

	.hall-of-fame__row {
		display: var(--parent-member-row-display);
		grid-template-columns: var(--parent-member-row-columns);
		align-items: var(--parent-member-row-alignment);
		padding: var(--parent-member-row-block-padding)
			var(--parent-member-row-inline-padding);
		overflow-x: var(--parent-member-row-overflow);
		overflow-y: var(--parent-member-row-block-overflow);
		gap: var(--parent-member-row-gap);
		scroll-padding-inline: var(--parent-member-row-inline-padding);
		scrollbar-width: none;
		scroll-snap-type: var(--parent-member-row-snap-type);
		touch-action: var(--parent-member-row-touch-action);
		overscroll-behavior-inline: var(--parent-member-row-overscroll);
		-webkit-overflow-scrolling: touch;
	}

	.hall-of-fame__row::-webkit-scrollbar {
		display: none;
	}

	.hall-of-fame__card {
		width: var(--parent-member-card-width);
		height: var(--parent-member-card-height);
		min-width: var(--space-page-reset);
		flex: var(--parent-member-card-flex);
		padding: var(--parent-member-card-inset);
		text-align: center;
		background: var(--color-parent-card-surface);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--parent-radius-card);
		box-shadow: var(--shadow-parent-card);
		scroll-snap-align: var(--parent-member-card-snap-align);
		scroll-snap-stop: var(--parent-member-card-snap-stop);
		transition: all var(--duration-parent-standard) ease;
	}

	.hall-of-fame--page .hall-of-fame__row {
		display: grid;
		grid-template-columns: var(--hall-page-grid-columns);
		padding: var(--hall-page-row-padding);
		overflow: var(--hall-page-row-overflow);
		gap: var(--hall-page-grid-gap);
		scroll-snap-type: var(--hall-page-row-snap-type);
		touch-action: var(--hall-page-row-touch-action);
	}

	.hall-of-fame--page .hall-of-fame__row-shell::after {
		display: none;
	}

	.hall-of-fame--page .hall-of-fame__card {
		width: var(--hall-page-card-width);
		height: var(--hall-page-card-height);
		min-width: var(--space-page-reset);
		flex: none;
	}

	.hall-of-fame__photo {
		width: var(--parent-member-photo-size);
		height: var(--parent-member-photo-size);
		margin-bottom: var(--space-parent-4);
		object-fit: cover;
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--radius-round);
	}

	.hall-of-fame__name {
		margin: var(--space-page-reset) var(--space-page-reset)
			var(--space-parent-2);
		color: var(--color-text-on-dark);
		font-size: var(--parent-member-name-size);
		font-weight: var(--font-weight-parent-bold);
		line-height: var(--line-height-parent-snug);
	}

	.hall-of-fame__detail {
		margin: var(--space-page-reset) var(--space-page-reset)
			var(--space-parent-1);
		color: var(--color-section-body-text);
		font-size: var(--parent-member-detail-size);
		font-weight: var(--font-weight-parent-regular);
		line-height: var(--line-height-parent-relaxed);
	}

	.hall-of-fame__socials {
		display: flex;
		justify-content: center;
		margin-top: var(--space-parent-4);
		gap: var(--space-parent-3);
	}

	.hall-of-fame__socials a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--parent-control-min-height);
		height: var(--parent-control-min-height);
		background: var(--color-parent-card-hover);
		border: var(--parent-border-width) solid var(--color-parent-border);
		border-radius: var(--radius-round);
		transition: all var(--duration-parent-control) var(--easing-parent-out);
	}

	.hall-of-fame__social-icon {
		width: var(--parent-icon-size);
		height: var(--parent-icon-size);
	}

	@media (hover: hover) and (pointer: fine) {
		.hall-of-fame__heading-link:hover svg,
		.hall-of-fame__heading-link:focus-visible svg {
			transform: translateX(var(--parent-arrow-hover-x));
		}

		.hall-of-fame__card:hover {
			border-color: var(--color-parent-brand-border-soft);
			transform: translateY(var(--parent-card-hover-offset));
		}

		.hall-of-fame__socials a:hover {
			border-color: var(--color-brand-primary);
			transform: translateY(var(--parent-cta-hover-offset))
				scale(var(--parent-logo-hover-scale));
		}
	}
</style>
