---
import { members } from '../data/members';

const githubIcon = `${import.meta.env.BASE_URL}assets/images/builderclan/github-mark.svg`;
const linkedinIcon = `${import.meta.env.BASE_URL}assets/images/builderclan/LinkedIn.svg`;
---

<section
	class="hall-of-fame section-jump-target"
	id="hall-of-fame"
	data-reveal="slide-up"
>
	<h3 class="hall-of-fame__heading">Hell Week 14B1 Hall of Fame</h3>
	<div class="hall-of-fame__row-shell" data-member-scroll-shell>
		<div
			class="hall-of-fame__row"
			data-member-scroll-row
			aria-label="Hall of Fame members; scroll horizontally for more"
		>
			{
				members.map((member) => (
					<article class="hall-of-fame__card">
						<img
							src={`${import.meta.env.BASE_URL}${member.photo}`}
							alt={member.name}
							class="hall-of-fame__photo"
						/>
						<h4 class="hall-of-fame__name">{member.name}</h4>
						<p class="hall-of-fame__detail">{member.department}</p>
						<p class="hall-of-fame__detail">{member.project}</p>

						<div class="hall-of-fame__socials">
							<a
								href={member.github}
								target="_blank"
								rel="noopener noreferrer"
							>
								<img
									src={githubIcon}
									alt={`${member.name} on GitHub`}
									class="hall-of-fame__social-icon"
								/>
							</a>
							<a
								href={member.linkedin}
								target="_blank"
								rel="noopener noreferrer"
							>
								<img
									src={linkedinIcon}
									alt={`${member.name} on LinkedIn`}
									class="hall-of-fame__social-icon"
								/>
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.hall-of-fame {
		width: min(var(--content-max-width), var(--content-width));
		margin: var(--space-page-reset) var(--space-centered);
		padding: var(--space-hall-section-top) var(--space-page-reset)
			var(--space-hall-section-bottom);
		color: var(--color-text-on-dark);
		text-align: left;
	}

	.hall-of-fame__heading {
		display: inline-block;
		margin: var(--space-page-reset) var(--space-centered);
		padding-bottom: var(--space-compact-control-gap);
		color: var(--color-brand-primary);
		font-size: var(--font-size-subsection-heading);
		font-weight: var(--font-weight-section-heading);
		border-bottom: var(--section-heading-border-width) solid
			var(--color-text-on-dark);
	}

	.hall-of-fame__row-shell {
		position: relative;
		margin-top: var(--space-section-gutter);
	}

	.hall-of-fame__row-shell::after {
		position: absolute;
		inset-block: var(--space-page-reset);
		inset-inline-end: var(--space-page-reset);
		z-index: var(--member-row-continuation-layer);
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--member-row-continuation-cue-width);
		color: var(--color-brand-primary);
		font-size: var(--font-size-subsection-heading);
		pointer-events: none;
		content: '→';
		opacity: var(--opacity-entry-start);
		background: var(--background-member-row-continuation-cue);
		transition: opacity var(--duration-button-hover) ease;
	}

	.hall-of-fame__row-shell[data-scrollable='true'][data-scroll-end='false']::after {
		opacity: var(--opacity-entry-end);
	}

	.hall-of-fame__row {
		display: flex;
		margin-top: var(--space-page-reset);
		padding: var(--space-hall-row-block) var(--space-hall-row-inline);
		overflow-x: auto;
		gap: var(--space-card-inset);
		scroll-padding-inline: var(--space-card-inset);
		scrollbar-width: none;
		scroll-snap-type: x mandatory;
		touch-action: pan-x;
		-webkit-overflow-scrolling: touch;
		-ms-overflow-style: none;
	}

	.hall-of-fame__card {
		padding: var(--space-card-inset);
		text-align: center;
		background: var(--color-hall-card-background);
		border-radius: var(--radius-hall-card);
		box-shadow: var(--shadow-hall-card);
		backdrop-filter: blur(var(--blur-hall-card));
		scroll-snap-align: start;
		scroll-snap-stop: always;
		transition:
			transform var(--duration-button-standard) ease,
			box-shadow var(--duration-button-standard) ease;
		/* The author appears to have intended a moving background, but the old
			card is a flat colour, so its background-position animation shows nothing. */
	}

	.hall-of-fame__photo {
		width: var(--member-photo-size);
		height: var(--member-photo-size);
		margin-bottom: var(--space-section-gutter);
		object-fit: cover;
		border-radius: var(--radius-round);
	}

	.hall-of-fame__name {
		color: var(--color-hall-member-name);
	}

	.hall-of-fame__detail {
		margin-bottom: var(--space-compact-control-gap);
		opacity: var(--opacity-member-detail);
	}

	.hall-of-fame__socials {
		display: flex;
		justify-content: center;
		margin-top: var(--space-section-gutter);
		gap: var(--space-section-gutter);
	}

	.hall-of-fame__socials a {
		margin: var(--space-page-reset) var(--space-compact-control-gap);
	}

	.hall-of-fame__social-icon {
		width: var(--social-icon-size);
		height: var(--social-icon-size);
	}

	@media (hover: hover) and (pointer: fine) {
		.hall-of-fame__card:hover {
			box-shadow: var(--shadow-hall-card-hover);
			transform: translateY(var(--offset-hall-card-hover));
		}

		.hall-of-fame__socials a:hover img {
			transform: scale(var(--scale-social-hover));
		}
	}
</style>
